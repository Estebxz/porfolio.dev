---
import Layout from "@base/Layout.astro";

import Footer from "@layout/Footer.astro";
import Box from "@ui/Box.astro";
import SocialLink from "@layout/SocialLink.astro";
import Hero from "@layout/Hero.astro";
import List from "@project/List.astro";
import ScrollIcon from "@asset/scroll-icon.svg";
import GetCopyword from "@svelte/GetCopyword.svelte";
---

<Layout
  title="Página de inicio — Joan"
  description="Colección de proyectos y experimentos en desarrollo web. Interfaces modernas, arquitectura frontend y soluciones orientadas a producto."
>
  <main>
    <Box id="hero" ariaLabel="Hero" class="flex min-h-svh-90 flex-col pt-14 pb-8 sm:pt-20">
      <Hero />
      <ScrollIcon
        aria-hidden="true"
        class:list={[
          "mt-auto",
          "size-6",
          "scroll-icon",
          "text-alpha-100",
          "self-center",
        ]}
      />
    </Box>

    <Box id="project" ariaLabel="Proyectos" class="mt-10">
      <List />
    </Box>

    <Box id="contact" ariaLabel="Contacto" class="mt-16 mb-12 sm:mt-20 sm:mb-16 md:mt-24 md:mb-20">
      <div class="mx-auto flex flex-col items-center justify-center gap-6 sm:gap-8 md:gap-10">
        <GetCopyword text="este.mendxz@gmail.com" client:visible />
        <SocialLink />
      </div>
    </Box>
  </main>
  <div class="flex items-center justify-center py-4 sm:py-6">
    <Footer />
  </div>
</Layout>

<style>
  @keyframes scroll-dot {
    0% {
      transform: translateY(-60px);
    }
    35% {
      transform: translateY(60px);
    }
    70% {
      transform: translateY(60px);
    }
    100% {
      transform: translateY(-60px);
    }
  }

  :global(.scroll-icon .scroll-icon__dot) {
    transform-origin: center;
    animation: scroll-dot 1.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.scroll-icon .scroll-icon__dot) {
      animation: none;
    }
  }
</style>
