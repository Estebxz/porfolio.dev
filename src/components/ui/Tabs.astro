---
export type TabOption = {
  key: string;
  label: string;
};

export type Props = {
  options: TabOption[];
  name: string;
  value?: string;
  ariaLabel?: string;
};

const { options, name, value, ariaLabel } = Astro.props;
---

<div aria-label={ariaLabel}>
  <div class="tabs">
    {
      options.map(({ key, label }) => (
        <div class="tab">
          <input
            type="radio"
            name={name}
            id={`${name}-${key}`}
            value={key}
            class="tab__input"
            checked={value === key}
          />
          <label for={`${name}-${key}`} class="tab__label">
            {label}
          </label>
        </div>
      ))
    }
  </div>
</div>

<style>
  .tabs {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.5rem;

    width: fit-content;
    max-width: 100%;

    padding: 4px;
    border-radius: 0.4rem;

    background: var(--color-primary-900);
    border: 1px solid var(--color-alpha-100);

    font-size: 0.85rem;
    line-height: 1;
  }

  .tab {
    display: flex;
    align-items: center;
  }

  .tab__input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .tab__label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;

    min-height: 44px;
    padding: 12px 16px;
    font-weight: 400;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;

    color: var(--color-alpha-100);
    background: transparent;
    border-radius: 0.4rem;

    cursor: pointer;
    user-select: none;

    transition:
      background-color 0.2s ease,
      transform 0.1s ease,
      color 0.2s ease;
  }

  .tab__input:checked + .tab__label {
    background: var(--color-alpha-100);
    color: var(--color-primary-900);
    transform: translateY(0);
  }

  .tab__input:active + .tab__label {
    transform: translateY(0);
  }

  @media (min-width: 768px) {
    .tab__label {
      padding: 14px 20px;
    }
  }
</style>
