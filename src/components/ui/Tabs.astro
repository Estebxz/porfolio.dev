---
export type TabOption = {
  key: string;
  label: string;
};

export type Props = {
  options: TabOption[];
  name: string;
  value?: string;
  ariaLabel?: string;
};

const { options, name, value, ariaLabel } = Astro.props;
---

<div class="tabs" aria-label={ariaLabel}>
  {
    options.map(({ key, label }) => (
      <div class="tab">
        <input
          type="radio"
          name={name}
          id={`${name}-${key}`}
          value={key}
          class="tab__input sr-only"
          checked={value === key}
        />
        <label for={`${name}-${key}`} class="tab__label">
          {label}
        </label>
      </div>
    ))
  }
</div>

<style>
  .tabs {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    width: fit-content;
    max-width: 100%;
    padding: 4px;
    border-radius: 0.4rem;
    background: var(--color-primary-900);
    border: 1px solid var(--color-alpha-200);
    font-size: 0.85rem;
    line-height: 1;
  }

  .tab__label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    min-height: 44px;
    padding: 12px clamp(16px, 2vw, 20px);
    font-weight: 400;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-alpha-100);
    border-radius: 0.4rem;
    cursor: pointer;
    user-select: none;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .tab__input:checked + .tab__label {
    background: var(--color-alpha-200);
    color: var(--color-primary-900);
  }
</style>