---
interface Props {
  href: string | null | undefined;
  title?: string;
  ariaLabel?: string;
  rel: string;
  target: "_blank" | "_self" | "_parent";
  class?: string | string[];
}

const {
  href: url = "",
  title,
  ariaLabel,
  rel,
  target,
  class: className = "",
} = Astro.props;
---

<a
  href={url}
  title={title}
  aria-label={ariaLabel}
  rel={rel}
  target={target}
  class:list={[
    "inline-flex items-center justify-center gap-1.5",
    "min-h-11 w-full md:w-auto px-4 py-3 md:px-5 md:py-3.5",
    "font-normal uppercase",
    "bg-primary-900 text-alpha-100 rounded-md",
    "transition-all duration-200 ease-in-out",
    "hover:bg-primary-700 hover:-translate-y-1",
    "active:translate-y-0",
    className,
  ]}
>
  <slot name="before" />
  <slot />
  <slot name="after" />
</a>
