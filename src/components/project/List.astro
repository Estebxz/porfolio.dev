---
import { getItems } from "@lib/collections";
import Tabs from "@ui/Tabs.astro";

const projects = await getItems();
const statusParam = Astro.url.searchParams.get("status");
const status =
  statusParam === "done" || statusParam === "in_progress" ? statusParam : "all";

const filters = [
  { key: "all", label: "Todos", href: "/#project" },
  { key: "in_progress", label: "En progreso", href: "/?status=in_progress#project" },
  { key: "done", label: "Terminado", href: "/?status=done#project" },
];
---

<div class="content-wrapper">
  <div class="projects-header">
    <h1 class="section-title">Proyectos</h1>

    <div class="flex my-4" aria-label="Filtrar proyectos">
      <Tabs
        options={filters}
        name="project-status"
        value={status}
        ariaLabel="Filtrar proyectos"
      />
    </div>
  </div>

  <section aria-labelledby="projects-title">
    <ul class="projects-list" role="list">
      {
        projects.map(({ slug, title, status }) => (
          <li class="project-item">
            <a
              class="hollow-text"
              href={`/projects/${slug}`}
              aria-label={`Ver proyecto ${title}`}
              transition:name={`title-${slug}`}
              data-astro-prefetch="viewport"
              data-status={status}
            >
              {title}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</div>

<script>
  const VALID = new Set(["all", "done", "in_progress"]);
  const STORAGE_KEY = "projects.status";

  const sanitize = (s: string | null) => (s && VALID.has(s) ? s : "all");
  const isActive = () => document.querySelector('input[name="project-status"]') !== null;

  function getStatus() {
    const param = new URL(window.location.href).searchParams.get("status");
    return sanitize(param ?? sessionStorage.getItem(STORAGE_KEY));
  }

  function setUrl(status: string) {
    const url = new URL(window.location.href);
    if (status === "all") url.searchParams.delete("status");
    else url.searchParams.set("status", status);
    url.hash = "project";
    history.replaceState({}, "", url);
  }

  function applyFilter(status: string) {
    if (status === "all") sessionStorage.removeItem(STORAGE_KEY);
    else sessionStorage.setItem(STORAGE_KEY, status);

    document.querySelectorAll<HTMLInputElement>('input[name="project-status"]')
      .forEach((input) => (input.checked = input.value === status));

    document.querySelectorAll<HTMLAnchorElement>("a[data-status]")
      .forEach((a) => {
        const li = a.closest("li");
        if (li) li.hidden = status !== "all" && a.getAttribute("data-status") !== status;
      });
  }

  function init() {
    if (!isActive()) return;

    applyFilter(getStatus());

    document.querySelectorAll<HTMLInputElement>('input[name="project-status"]')
      .forEach((input) =>
        input.addEventListener("change", () => {
          const status = sanitize(input.value);
          setUrl(status);
          applyFilter(status);
        })
      );
  }

  document.addEventListener("astro:page-load", init);
</script>

<style>
  .projects-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0rem;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .projects-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .hollow-text {
    font-family: var(--font-bbh-bartle);
    text-transform: uppercase;

    font-size: clamp(2.4rem, 7vw, 5.5rem);
    line-height: 1em;
    width: 100%;
    min-width: 0;

    color: transparent;
    cursor: pointer;

    /* Stroke */
    -webkit-text-stroke: 1.2px oklch(0.8853 0 0);

    /* Relleno animado */
    background: linear-gradient(oklch(0.8853 0 0));
    background-size: 100% 0%;
    background-position: bottom;
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;

    /* Animación */
    transition:
      background-size 0.45s ease,
      -webkit-text-stroke-color 0.45s ease;
  }

  .hollow-text:hover {
    background-size: 100% 100%;
  }

  @media (max-width: 374px) {
    .hollow-text {
      font-size: clamp(1.8rem, 7vw, 2.4rem);
      -webkit-text-stroke-width: 0.8px;

      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
      text-overflow: ellipsis;
      overflow-wrap: break-word;
      word-break: normal;
      hyphens: auto;
    }
  }

  @media (min-width: 375px) and (max-width: 639px) {
    .hollow-text {
      font-size: clamp(2rem, 8vw, 2.8rem);
      -webkit-text-stroke-width: 1px;

      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
      text-overflow: ellipsis;
      overflow-wrap: break-word;
      word-break: normal;
      hyphens: auto;
    }
  }

  @media (min-width: 640px) {
    .hollow-text {
      display: block;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .hollow-text {
      font-size: clamp(3.5rem, 6vw, 4.5rem);
      letter-spacing: 0.05em;
      -webkit-text-stroke-width: 1.2px;
    }
  }

  @media (min-width: 1024px) and (max-width: 1439px) {
    .hollow-text {
      font-size: clamp(4rem, 5.5vw, 5.5rem);
      letter-spacing: 0.05em;
      -webkit-text-stroke-width: 1.5px;
      max-width: 100%;
    }
  }

  @media (min-width: 1440px) {
    .hollow-text {
      font-size: clamp(5rem, 5vw, 6.5rem);
      letter-spacing: 0.05em;
      -webkit-text-stroke-width: 1.8px;
    }
  }
</style>
