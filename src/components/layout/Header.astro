---
import UseIcon from "@ui/UseIcon.astro";
import { MAIN } from "@constants/navigation";

import Logo from "@asset/logo.svg";
---

<header class="header sticky top-0 z-50" id="navbar" transition:persist>
  <div class="content-view relative">
    <a
      href="/"
      aria-label="Inicio"
      class="group text-alpha-200 hover:text-yellow inline-flex transition-colors duration-300"
    >
      <Logo
        width="40"
        height="40"
        class="-rotate-8 fill-current transition-transform duration-300 ease-out group-hover:rotate-0"
      />
    </a>

    <button
      id="menu-toggle"
      type="button"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Abrir menú"
      class="text-alpha-200 bg-primary-700 border-alpha-200/40 inline-flex size-10 items-center justify-center rounded-md border transition-transform md:hidden"
    >
      <span class="sr-only" id="menu-label">Abrir menú</span>
      <UseIcon name="hamburger" class="icon text-alpha-100" />
    </button>

    <nav class="hidden md:block" aria-label="Menú principal">
      <ul class="flex flex-row gap-4" role="list">
        {
          MAIN.map(({ url, title, label }) => {
            if (!url) return null;
            const hash = url.includes("#") ? `#${url.split("#")[1]}` : "";
            return (
              <li>
                <a
                  href={url}
                  title={label}
                  aria-label={label}
                  class="nav-base hover:border-alpha-100 hover:text-alpha-100 uppercase transition-colors duration-300"
                  data-nav-hash={hash || undefined}
                >
                  {title}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <nav
      id="mobile-menu"
      class="mobile-menu-list absolute top-full right-0 mr-4 opacity-0 transition-all duration-300 md:hidden"
      aria-label="Menú móvil"
    >
      <ul class="flex flex-col" role="list">
        {
          MAIN.map(({ url, title, label }) => {
            if (!url) return null;
            const hash = url.includes("#") ? `#${url.split("#")[1]}` : "";
            return (
              <li>
                <a
                  href={url}
                  title={label}
                  aria-label={label}
                  class="nav-base"
                  data-nav-hash={hash || undefined}
                >
                  {title}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const bind = () => {
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");
    const label = document.getElementById("menu-label");
    if (!toggle || !menu) return;

    const ac = new AbortController();
    const { signal } = ac;

    const navLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>("a[data-nav-hash]"),
    );

    const setActiveHash = (hash: string) => {
      const normalized = hash?.startsWith("#") ? hash : "";
      for (const a of navLinks) {
        const active = !!normalized && a.dataset.navHash === normalized;
        const isMobile = !!a.closest("#mobile-menu");
        a.classList.toggle("border-none", !active);
        a.classList.toggle("lg:border-alpha-100", active);
        a.classList.toggle("text-alpha-100", active);
        a.classList.toggle("bg-alpha-800/40", active && isMobile);
        a.toggleAttribute("aria-current", active);
      }
    };

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      const txt = open ? "Cerrar menú" : "Abrir menú";
      toggle.setAttribute("aria-label", txt);
      if (label) label.textContent = txt;
      menu.classList.toggle("opacity-0", !open);
      menu.classList.toggle("pointer-events-none", !open);
      menu.classList.toggle("opacity-100", open);
      menu.classList.toggle("pointer-events-auto", open);
    };

    const isOpen = () => toggle.getAttribute("aria-expanded") === "true";

    setOpen(false);
    setActiveHash(window.location.hash);

    // Intersection observer para secciones
    const sections = navLinks
      .map((a) => (a.dataset.navHash || "").replace(/^#/, ""))
      .filter(Boolean)
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => !!el);

    if (sections.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          const top = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (top?.target instanceof HTMLElement)
            setActiveHash(`#${top.target.id}`);
        },
        { threshold: [0.4, 0.6] },
      );
      sections.forEach((s) => observer.observe(s));
      signal.addEventListener("abort", () => observer.disconnect());
    }

    // Eventos — todos con signal para cleanup automático
    window.addEventListener("hashchange", () => setActiveHash(window.location.hash), { signal });
    toggle.addEventListener("click", () => setOpen(!isOpen()), { signal });
    menu.addEventListener("click", (e) => {
      if (e.target instanceof Element && e.target.closest("a")) setOpen(false);
    }, { signal });
    document.addEventListener("click", (e) => {
      if (isOpen() && e.target instanceof Node && !menu.contains(e.target) && !toggle.contains(e.target))
        setOpen(false);
    }, { signal });

    document.addEventListener("astro:before-swap", () => ac.abort(), { once: true, signal });
  };

  document.addEventListener("astro:page-load", bind);
</script>

<style>
  header {
    background: transparent;
    animation: ui-scroll 0.3s linear both;
    animation-timeline: scroll();
    animation-range: 0 250px;
  }

  @keyframes ui-scroll {
    0% {
      backdrop-filter: blur(0px);
      background: transparent;
    }

    100% {
      backdrop-filter: blur(10px);
      background: var(--color-primary-900/60);
      padding-bottom: var(--spacing-6);
    }
  }
</style>
